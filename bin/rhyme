#!/usr/bin/env python3
"""rhyme — report rhyme candidates and relationships.

Reports type + closeness, never a verdict. The ear decides what works.

Usage:
  rhyme <word|phrase> [--want perfect|family|slant] [--syllables N] [--multi] [--limit N]
  rhyme <word> --against "<line>"
"""

import argparse
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "lib"))
import phonetics as ph  # noqa: E402


def main():
    ap = argparse.ArgumentParser(add_help=True, description="report rhyme candidates and relationships")
    ap.add_argument("words", nargs="+", help="word or phrase (rhymes on the last word)")
    ap.add_argument("--against", metavar="LINE", help="classify against the last word of this line")
    ap.add_argument("--want", choices=["perfect", "family", "slant"], help="filter by rhyme type")
    ap.add_argument("--syllables", type=int, help="only candidates with N syllables")
    ap.add_argument("--multi", action="store_true", help="multisyllabic rhyme (from 2nd-to-last stress)")
    ap.add_argument("--limit", type=int, default=40)
    args = ap.parse_args()

    target = ph.last_word(" ".join(args.words))
    if not target:
        ap.error("need a word or phrase")

    if args.against:
        other = ph.last_word(args.against)
        r = ph.rhyme_between(target, other, multi=args.multi)
        if r["closeness"] is None:
            print(f'{target} / {other}  ->  {r["type"]} '
                  f'(spelling guess, low confidence — "{r["missing"]}" not in dictionary)')
        else:
            print(f'{target} / {other}  ->  {r["type"]}, {r["closeness"]}')
        return

    res = ph.find_rhymes(target, multi=args.multi, syllables=args.syllables,
                         want=args.want, limit=args.limit)
    if not res["ok"]:
        print(f'"{target}" not in dictionary — no reliable phonetics. '
              f"Try a simpler spelling, or trust your ear.")
        return

    tail = " ".join(res["tail"])
    multi = "  (multisyllabic)" if args.multi else ""
    print(f'rhymes for "{target}"  [tail: {tail}]{multi}')
    if not res["results"]:
        print("  (none found for these filters)")
        return
    w = max(len(r["word"]) for r in res["results"])
    for r in res["results"]:
        print(f'  {r["word"]:<{w}}   {r["type"]:<10} {r["closeness"]}')


if __name__ == "__main__":
    main()
